{
  "enabled": false,
  "PreToolUse": [
    {
      "matcher": "run_command",
      "hooks": [
        {
          "type": "command",
          "command": "python tools/hooks/guard_git.py"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "write_to_file",
      "hooks": [
        {
          "type": "command",
          "command": "python tools/hooks/check_agent_docs.py"
        }
      ]
    }
  ]
}
